* { box-sizing: border-box; }

:root {
  --brand: #28a7c9;
  --brand-dark: #147f9d;
  --ink: #14213d;
  --muted: #6b7280;
  --line: #e5e7eb;
  --surface: #ffffff;
  --soft: #f5f8fb;
  --success: #16a34a;
  --danger: #dc2626;
}

body {
  margin: 0;
  background: #f3f6f9;
  color: var(--ink);
}

button, input, textarea { font: inherit; }
button { transition: transform .2s ease, box-shadow .2s ease, background .2s ease; }
button:hover { transform: translateY(-1px); }

.dashboard-page {
  min-height: 100vh;
  background:
    radial-gradient(circle at top right, rgba(40,167,201,.12), transparent 28%),
    linear-gradient(180deg, #f8fbfd 0%, #f3f6f9 100%);
  padding: 24px;
}

.dashboard-shell { max-width: 1240px; margin: 0 auto; }

.dashboard-topbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20px;
  margin-bottom: 30px;
}

.dashboard-brand-mini { display: flex; align-items: center; gap: 10px; font-weight: 800; }
.dashboard-brand-mini img { width: 44px; height: 44px; object-fit: contain; }
.dashboard-topbar-actions { display: flex; gap: 10px; }

.dashboard-welcome {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 24px;
  padding: 34px;
  background: linear-gradient(135deg, #132238, #1c3b52);
  border-radius: 26px;
  color: #fff;
  box-shadow: 0 24px 60px rgba(20,33,61,.16);
  margin-bottom: 24px;
}

.dashboard-welcome h1 { font-size: clamp(30px, 4vw, 48px); line-height: 1.05; margin: 8px 0 12px; }
.dashboard-welcome p { max-width: 690px; margin: 0; color: rgba(255,255,255,.75); font-size: 16px; }
.dashboard-eyebrow { display: inline-block; font-size: 12px; letter-spacing: .14em; font-weight: 800; color: var(--brand); }

.dashboard-status-pill {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 10px 14px;
  border-radius: 999px;
  font-weight: 700;
  text-transform: capitalize;
  background: rgba(255,255,255,.12);
}
.dashboard-status-dot { width: 9px; height: 9px; border-radius: 50%; background: currentColor; }
.dashboard-status-pill.is-active { color: #86efac; }
.dashboard-status-pill.is-inactive { color: #fca5a5; }

.dashboard-stats-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 18px;
  margin-bottom: 34px;
}

.dashboard-stat-card {
  position: relative;
  min-height: 170px;
  padding: 24px;
  background: var(--surface);
  border: 1px solid rgba(20,33,61,.07);
  border-radius: 22px;
  box-shadow: 0 14px 40px rgba(15,23,42,.06);
  overflow: hidden;
}
.dashboard-stat-primary { background: linear-gradient(135deg, #ecfbff, #fff); }
.dashboard-stat-icon { width: 38px; height: 38px; display: grid; place-items: center; background: #e9f8fc; color: var(--brand-dark); border-radius: 12px; margin-bottom: 16px; font-weight: 900; }
.dashboard-stat-card p { margin: 0 0 8px; color: var(--muted); font-size: 13px; font-weight: 700; text-transform: uppercase; letter-spacing: .05em; }
.dashboard-stat-card h2 { margin: 0 0 6px; font-size: 34px; }
.dashboard-stat-card span { color: #8a94a3; font-size: 13px; }
.dashboard-plan-name { font-size: 22px !important; line-height: 1.2; }
.text-success { color: var(--success); }
.text-danger { color: var(--danger); }

.dashboard-progress { position: absolute; left: 24px; right: 24px; bottom: 20px; height: 7px; background: #dcecf1; border-radius: 999px; overflow: hidden; }
.dashboard-progress-filled { height: 100%; background: linear-gradient(90deg, var(--brand), #57c7e2); border-radius: inherit; }

.dashboard-workspace { display: grid; grid-template-columns: minmax(0, 1fr) 310px; gap: 26px; align-items: start; }
.dashboard-main-column { min-width: 0; }
.dashboard-sidebar { display: grid; gap: 18px; position: sticky; top: 20px; }

.dashboard-section-heading { display: flex; gap: 16px; align-items: flex-start; margin: 34px 0 16px; }
.dashboard-section-heading > span { display: grid; place-items: center; width: 42px; height: 42px; flex: 0 0 42px; border-radius: 13px; background: #dff5fb; color: var(--brand-dark); font-weight: 900; }
.dashboard-section-heading h2 { margin: 0 0 4px; font-size: 24px; }
.dashboard-section-heading p { margin: 0; color: var(--muted); }

.dashboard-panel, .dashboard-sidebar-card {
  background: var(--surface);
  border: 1px solid rgba(20,33,61,.07);
  border-radius: 22px;
  box-shadow: 0 16px 45px rgba(15,23,42,.06);
}
.dashboard-panel { padding: 28px; }
.dashboard-sidebar-card { padding: 24px; }
.dashboard-sidebar-card h3 { margin: 0 0 12px; }
.dashboard-sidebar-card p { margin: 0; color: var(--muted); line-height: 1.65; }
.dashboard-help-card { background: linear-gradient(145deg, #132238, #1d4259); color: #fff; }
.dashboard-help-card p { color: rgba(255,255,255,.72); }
.dashboard-sidebar-icon { display: block; font-size: 28px; margin-bottom: 14px; }
.dashboard-usage-row { display: flex; justify-content: space-between; padding: 12px 0; border-bottom: 1px solid var(--line); color: var(--muted); }
.dashboard-usage-row:last-child { border-bottom: 0; }
.dashboard-usage-row strong { color: var(--ink); }

.dashboard-panel-header { display: flex; justify-content: space-between; gap: 16px; margin-bottom: 12px; }
.dashboard-panel-header h3 { margin: 6px 0 0; }
.dashboard-panel-kicker { color: var(--brand); font-size: 12px; font-weight: 900; letter-spacing: .12em; }
.dashboard-tip { padding: 12px 14px; margin-bottom: 14px; border-radius: 12px; background: #fff8e8; color: #7c5b12; font-size: 13px; }
.dashboard-language-divider { height: 1px; background: var(--line); margin: 28px 0; }

.dashboard-input {
  width: 100%;
  border: 1px solid #dfe5eb;
  border-radius: 13px;
  padding: 14px 15px;
  background: #fbfcfd;
  color: var(--ink);
  outline: none;
  transition: border .2s ease, box-shadow .2s ease, background .2s ease;
}
.dashboard-input:focus { border-color: var(--brand); background: #fff; box-shadow: 0 0 0 4px rgba(40,167,201,.12); }
.dashboard-textarea { resize: vertical; line-height: 1.6; }
.dashboard-form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
.dashboard-form-grid label { display: grid; gap: 8px; }
.dashboard-form-grid label > span { font-size: 13px; font-weight: 800; }
.dashboard-panel-actions, .dashboard-send-actions { display: flex; gap: 12px; margin-top: 20px; flex-wrap: wrap; }

.dashboard-button {
  border: 0;
  border-radius: 12px;
  padding: 12px 18px;
  cursor: pointer;
  font-weight: 800;
}
.dashboard-button-primary { background: linear-gradient(135deg, var(--brand), #1c8fad); color: #fff; box-shadow: 0 10px 24px rgba(40,167,201,.24); }
.dashboard-button-outline { background: #fff; color: var(--ink); border: 1px solid #d9e1e8; }
.dashboard-button-light { background: #fff; color: var(--ink); border: 1px solid var(--line); }
.dashboard-button-dark { background: var(--ink); color: #fff; }
.dashboard-button-danger { background: #fff; color: var(--danger); border: 1px solid #fecaca; }
.dashboard-full-button { width: 100%; }

.dashboard-plans-section, .dashboard-faq-section { margin-top: 84px; }
.dashboard-centered-heading { max-width: 680px; margin: 0 auto 34px; text-align: center; }
.dashboard-centered-heading h2 { font-size: clamp(28px, 4vw, 40px); margin: 8px 0 10px; }
.dashboard-centered-heading p { color: var(--muted); margin: 0; }
.dashboard-plans-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; }
.dashboard-plan-card { position: relative; display: flex; flex-direction: column; gap: 24px; padding: 30px; background: #fff; border: 1px solid var(--line); border-radius: 22px; box-shadow: 0 16px 50px rgba(15,23,42,.05); }
.dashboard-plan-card.is-featured { border: 2px solid var(--brand); transform: translateY(-8px); box-shadow: 0 24px 65px rgba(40,167,201,.16); }
.dashboard-popular-badge { position: absolute; top: -13px; left: 50%; transform: translateX(-50%); white-space: nowrap; background: var(--brand); color: #fff; padding: 7px 14px; border-radius: 999px; font-size: 11px; font-weight: 900; letter-spacing: .08em; }
.dashboard-plan-card h3 { margin: 0 0 16px; font-size: 22px; }
.dashboard-price strong { font-size: 40px; }
.dashboard-price span { color: var(--muted); }
.dashboard-sms-count { margin-top: 7px; color: var(--brand-dark); font-weight: 800; }
.dashboard-plan-card ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 11px; color: #4b5563; }
.dashboard-plan-card li { display: flex; gap: 10px; line-height: 1.45; }
.dashboard-plan-card li span { color: var(--success); font-weight: 900; }
.dashboard-plan-card .dashboard-button { margin-top: auto; width: 100%; }

.dashboard-account-actions { display: flex; justify-content: center; gap: 12px; flex-wrap: wrap; margin: 42px 0; }
.dashboard-faq-list { max-width: 860px; margin: 0 auto; display: grid; gap: 12px; }
.dashboard-faq-item { background: #fff; border: 1px solid var(--line); border-radius: 16px; overflow: hidden; cursor: pointer; }
.dashboard-faq-question { display: flex; justify-content: space-between; align-items: center; gap: 20px; padding: 20px 22px; font-weight: 800; }
.dashboard-faq-question button { width: 32px; height: 32px; border: 0; border-radius: 50%; background: #eef8fb; color: var(--brand-dark); font-size: 20px; cursor: pointer; }
.dashboard-faq-item.is-open .dashboard-faq-question button { transform: rotate(45deg); }
.dashboard-faq-answer { max-height: 0; opacity: 0; overflow: hidden; transition: .3s ease; }
.dashboard-faq-answer p { margin: 0; padding: 0 22px 22px; color: var(--muted); line-height: 1.7; }
.dashboard-faq-item.is-open .dashboard-faq-answer { max-height: 340px; opacity: 1; }

.dashboard-footer { text-align: center; padding: 80px 0 30px; color: var(--muted); }
.dashboard-footer img { max-height: 88px; width: auto; }

.dashboard-popup { position: fixed; inset: 0; z-index: 1000; display: grid; place-items: center; padding: 20px; background: rgba(15,23,42,.58); backdrop-filter: blur(8px); }
.dashboard-popup-content { width: min(560px, 100%); display: grid; gap: 14px; background: #fff; border-radius: 22px; padding: 28px; box-shadow: 0 30px 90px rgba(0,0,0,.26); }
.dashboard-modal-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 6px; }
.dashboard-modal-header h3 { margin: 6px 0 0; font-size: 26px; }
.dashboard-modal-header button { background: transparent; border: 0; font-size: 28px; color: var(--muted); cursor: pointer; }

.dashboard-container { min-height: 100vh; display: grid; place-items: center; font-size: 18px; }
.dashboard-container.error { color: var(--danger); }
.home-footer { text-align: center; }

@media (max-width: 1050px) {
  .dashboard-stats-grid { grid-template-columns: repeat(2, 1fr); }
  .dashboard-workspace { grid-template-columns: 1fr; }
  .dashboard-sidebar { position: static; grid-template-columns: repeat(2, 1fr); }
  .dashboard-sidebar > .dashboard-full-button { grid-column: 1 / -1; }
}

@media (max-width: 780px) {
  .dashboard-page { padding: 14px; }
  .dashboard-welcome { flex-direction: column; padding: 26px; }
  .dashboard-plans-grid { grid-template-columns: 1fr; }
  .dashboard-plan-card.is-featured { transform: none; }
  .dashboard-form-grid { grid-template-columns: 1fr; }
  .dashboard-sidebar { grid-template-columns: 1fr; }
}

@media (max-width: 560px) {
  .dashboard-topbar { align-items: flex-start; }
  .dashboard-brand-mini span { display: none; }
  .dashboard-topbar-actions { width: 100%; justify-content: flex-end; }
  .dashboard-stats-grid { grid-template-columns: 1fr; }
  .dashboard-panel { padding: 20px; }
  .dashboard-send-actions .dashboard-button, .dashboard-panel-actions .dashboard-button { width: 100%; }
  .dashboard-welcome h1 { font-size: 32px; }
}